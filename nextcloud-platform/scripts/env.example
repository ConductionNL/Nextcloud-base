# =============================================================================
# NEXTCLOUD TENANT SECRETS - Copy to .env and fill in your values
# =============================================================================
# This file is used by create-tenant-secret.sh
# NEVER commit .env to git! (already in .gitignore)
#
# Usage:
#   cp env.example .env
#   # Replace ALL placeholder values below with real credentials.
#   # Generate passwords with: openssl rand -hex 16
#   ./create-tenant-secret.sh
# =============================================================================

# Tenant identifier (e.g., "canary", "acme", "production")
TENANT_NAME=my-tenant

# Optional: override namespace (default is nc-<TENANT_NAME>)
# Use this when tenant.namespace is set to something else (e.g. "test-mariadb")
# TENANT_NAMESPACE=test-my-tenant

# Nextcloud admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zC6UMGUwD617N9TaO83sLWqC

# =============================================================================
# S3 STORAGE (Fuga Cloud)
# =============================================================================
S3_ACCESS_KEY=UWrnUyXrWIyLnp6TiL4zo6Zy
S3_SECRET_KEY=hvNWOM8wtzFl05JTJYgwVe8H

# =============================================================================
# DATABASE - Choose ONE option
# =============================================================================

# Option A: MariaDB (in-cluster, default)
# Only need root password - user password is generated
MARIADB_ROOT_PASSWORD=pYuDy8jyfrslMNac0P1zcW6L
MARIADB_PASSWORD=2O0tQNPaabkeQeF9a5gNKGff

# Option B: PostgreSQL (in-cluster)
# Only need these if using postgresql.enabled=true
POSTGRES_PASSWORD=wLQimXxg2cW3RK6aNuBZOAoq
DB_USERNAME=nextcloud
DB_PASSWORD=p1urGRsUmjOuUS89ltXXASAe

# =============================================================================
# REDIS (only for per-tenant Redis, not platform Redis)
# =============================================================================
REDIS_PASSWORD=9iw4fIUbt1d3UNJvGkMNqEap

# =============================================================================
# SMTP (optional - for email notifications)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_USERNAME=nc-smtp-user
# SMTP_PASSWORD=Kp2mXvR8nQ4wYjL5zTsH7cBd

